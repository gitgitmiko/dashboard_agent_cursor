[Unit]
Description=Pemantau harga Tokocrypto
After=network-online.target
Wants=network-online.target

[Service]
User=gitgitmiko
Group=gitgitmiko
WorkingDirectory=/home/gitgitmiko/harga-hbar
ExecStart=/home/gitgitmiko/harga-hbar/.venv/bin/uvicorn web:app --host 127.0.0.1 --port 8787 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
